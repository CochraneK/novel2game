{
  "name": "changan-lantern",
  "version": "5.5.0",
  "private": true,
  "description": "长安十二时辰 · 灯火如昼 —— 浏览器单页剧情冒险 + MBTI 人格画像（零运行时依赖）",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "python -m http.server 8010",
    "verify": "node tools/audit/verify.mjs",
    "check:readme": "node tools/audit/check_readme.mjs",
    "simulate": "node tools/sim/simulate.mjs",
    "audit": "node tools/audit/psy_audit.mjs",
    "audit:branch": "node tools/audit/branch_audit.mjs",
    "audit:passage": "node tools/audit/passage_audit.mjs",
    "trace": "node tools/sim/trace_choices.mjs",
    "trace:brief": "node tools/sim/trace_choices.mjs --brief",
    "dump": "python tools/smoke/dump_play.py",
    "dump:endings": "python tools/smoke/dump_play.py endings",
    "test": "node tools/audit/verify.mjs && node tools/sim/simulate.mjs",
    "test:all": "node tools/audit/verify.mjs && node tools/audit/check_readme.mjs && node tools/sim/simulate.mjs && node tools/audit/branch_audit.mjs && node tools/audit/passage_audit.mjs && node tools/audit/continuity_audit.mjs && node tools/audit/psy_audit.mjs",
    "smoke": "python tools/smoke/smoke.py",
    "smoke:psy": "python tools/smoke/smoke_psy.py",
    "smoke:mbti": "python tools/smoke/smoke_mbti.py",
    "smoke:text": "python tools/smoke/smoke_text.py",
    "smoke:gate": "python tools/smoke/smoke_gate.py",
    "smoke:results": "python tools/smoke/smoke_results.py",
    "shot:passage": "python tools/smoke/shot_passage.py",
    "dist": "python tools/smoke/mbti_dist.py",
    "audit:continuity": "node tools/audit/continuity_audit.mjs"
  }
}
